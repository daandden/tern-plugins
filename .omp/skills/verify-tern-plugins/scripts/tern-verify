#!/bin/sh
# Runs one isolated Tern window that loads the plugins of one tern-plugins checkout, and drives it.
# Every command takes the run dir first. The instance keeps all of its state in RUN/data: its own
# configuration dir, daemon socket and control socket, so it never touches the Tern that you use.
#
#   tern-verify start  RUN            link the plugins, copy settings.json, open the window, wait
#   tern-verify doctor RUN            read-only check of the instance
#   tern-verify ctl    RUN ARGS...    `tern ctl` on the instance's control socket
#   tern-verify tern   RUN ARGS...    any `tern` CLI command against the instance
#   tern-verify type   RUN LINE       types LINE and Enter into the focused pane
#   tern-verify shot   RUN NAME       RUN/NAME.webp (lossless) and RUN/NAME.layout.json
#   tern-verify lens   RUN            links RUN/link-lens: `echo PROBE_LINK URL` shows URL as a link
#   tern-verify stop   RUN            close the window, stop its daemon, remove RUN/data
#
# TERN_PLUGINS_REPO overrides the checkout whose plugins load (default: the checkout of this file).

set -eu

die() {
	printf 'tern-verify: %s\n' "$*" >&2
	exit 1
}

[ $# -ge 2 ] || die "usage: tern-verify start|doctor|ctl|tern|type|shot|lens|stop RUN [ARGS...]"
cmd=$1
case $2 in
/*) run=$2 ;;
*) run=$(pwd)/$2 ;;
esac
shift 2

data=$run/data
cfg=$data/config
ctl_sock=$data/ctl.sock
daemon_sock=$data/daemon.sock
script_dir=$(cd "$(dirname "$0")" && pwd -P)
repo=${TERN_PLUGINS_REPO:-$(git -C "$script_dir" rev-parse --show-toplevel)}

# A tern command against this instance only. With the TERN_PANE* and TERN_WINDOW* variables of the
# calling pane, a CLI command goes to the window of that pane.
iso() {
	env -u TERN_PANE -u TERN_PANE_SOCKET -u TERN_WINDOW_KEY -u TERN_WINDOW_SOCKET \
		TERN_CONFIG_DIR="$cfg" TERN_DAEMON_SOCKET="$daemon_sock" "$@"
}

ctl() {
	iso tern ctl --control "$ctl_sock" "$@"
}

# The pid that holds a socket file open, or nothing.
socket_owner() {
	[ -S "$1" ] && lsof -t "$1" 2>/dev/null | head -n 1 || true
}

# The omp session dir of a pane that ran omp in RUN/data, as omp names it.
omp_session_dir() {
	rel=${data#"$HOME"/}
	printf '%s/.omp/agent/sessions/-%s\n' "$HOME" "$(printf %s "$rel" | tr / -)"
}

case $cmd in
start)
	[ -d "$run" ] || die "$run does not exist: make it with mktemp -d"
	# mkdir without -p fails when the dir exists, so two starts on one run dir cannot both pass.
	mkdir "$data" 2>/dev/null || die "$data exists: another run owns $run, so do not stop it"
	mkdir "$cfg"
	if [ -f "$HOME/.config/tern/settings.json" ]; then
		cp "$HOME/.config/tern/settings.json" "$cfg/settings.json"
	else
		echo '{}' >"$cfg/settings.json"
	fi
	jq '.shell = "/opt/homebrew/bin/fish"' "$cfg/settings.json" >"$cfg/settings.json.new"
	mv "$cfg/settings.json.new" "$cfg/settings.json"
	# A config dir with no omp state makes Tern show its native "Tern is better with omp. Install it?"
	# alert on top of the screen. This is the state that Tern writes when you answer Not Now.
	mkdir "$cfg/omp"
	printf '{"managed":false,"checked":0,"no_build":false,"offered":true}\n' >"$cfg/omp/state.json"
	for manifest in "$repo"/*/plugin.toml; do
		iso tern plugin link "$(dirname "$manifest")" >>"$run/start.log" 2>&1 ||
			die "plugin link failed for $(dirname "$manifest"), see $run/start.log"
	done
	/usr/bin/caffeinate -u -t 2
	cd "$data"
	env -u TERN_PANE -u TERN_PANE_SOCKET -u TERN_WINDOW_KEY -u TERN_WINDOW_SOCKET \
		TERN_CONFIG_DIR="$cfg" TERN_DAEMON_SOCKET="$daemon_sock" \
		tern --control "$ctl_sock" "$data" >"$run/window.log" 2>&1 </dev/null &
	echo $! >"$data/window.pid"
	/usr/bin/caffeinate -d -w "$!" >/dev/null 2>&1 &
	tries=0
	until [ -S "$ctl_sock" ] && ctl css 2>/dev/null | grep -q '"plugin:local:'; do
		tries=$((tries + 1))
		[ $tries -le 60 ] || die "no plugin sheets after 30 s, see $run/window.log"
		sleep 0.5
	done
	ctl ready >/dev/null || die "no shell prompt, see $run/window.log"
	socket_owner "$daemon_sock" >"$data/daemon.pid"
	[ -s "$data/daemon.pid" ] || die "no session daemon on $daemon_sock, see $run/window.log"
	printf 'ready: window pid %s, daemon pid %s, repo %s\n' \
		"$(cat "$data/window.pid")" "$(cat "$data/daemon.pid")" "$repo"
	;;
doctor)
	status=0
	window_pid=$(cat "$data/window.pid" 2>/dev/null || true)
	printf 'run:        %s\n' "$run"
	printf 'repo:       %s (%s)\n' "$repo" "$(git -C "$repo" rev-parse --short HEAD)"
	printf 'tern:       %s\n' "$(tern --version)"
	if [ -n "$window_pid" ] && kill -0 "$window_pid" 2>/dev/null; then
		printf 'window:     pid %s alive\n' "$window_pid"
	else
		printf 'window:     NOT RUNNING (pid %s)\n' "${window_pid:-none}"
		status=1
	fi
	printf 'ctl.sock:   owner %s\n' "$(socket_owner "$ctl_sock")"
	daemon_pid=$(socket_owner "$daemon_sock")
	if [ -n "$daemon_pid" ]; then
		printf 'daemon:     pid %s (started as %s)\n' "$daemon_pid" "$(cat "$data/daemon.pid" 2>/dev/null || echo none)"
	else
		printf 'daemon:     NOT RUNNING (started as %s)\n' "$(cat "$data/daemon.pid" 2>/dev/null || echo none)"
		status=1
	fi
	if ! ctl state >"$data/doctor-state.json" 2>&1; then
		printf 'ctl state:  FAILED: %s\n' "$(cat "$data/doctor-state.json")"
		status=1
	else
		printf 'sessions:   %s\n' "$(jq -c '[.sessions[] | {name, tabs}]' "$data/doctor-state.json")"
		printf 'focused:    %s\n' "$(jq -c '.focused | {id, label}' "$data/doctor-state.json")"
	fi
	daemon_sessions=$(iso tern ls 2>&1) || status=1
	if [ "$daemon_sessions" = "no sessions" ]; then
		printf 'daemon sessions: NONE\n'
		status=1
	fi
	printf 'plugins:\n'
	iso tern plugin list | sed 's/^/  /'
	if iso tern plugin list | grep -qv ' ready$'; then status=1; fi
	for link in "$cfg"/plugins/*.path; do
		target=$(cat "$link")
		case $target in
		"$repo"/*) ;;
		"$run"/link-lens) printf 'run lens:   %s\n' "$target" ;;
		*)
			printf 'LINK OUTSIDE REPO: %s -> %s\n' "$link" "$target"
			status=1
			;;
		esac
	done
	printf 'sheets:     %s\n' "$(ctl css | jq -r '[.sheets[].name | select(startswith("plugin:"))] | join(" ")')"
	account=$(ctl a11y | jq -r '[.. | objects | select(.role == "Button") | .name // empty
		| select(startswith("Signed in to Stencil"))][0] // "NOT SIGNED IN"')
	printf 'account:    %s\n' "$account"
	[ "$account" != "NOT SIGNED IN" ] || status=1
	# Shots do not show a native alert, so list it here.
	alerts=$(ctl system | jq -r '.dialogs[] | "\(.message) \(.buttons)"')
	if [ -n "$alerts" ]; then
		printf 'NATIVE ALERT OPEN: %s\n' "$alerts"
		status=1
	else
		printf 'alerts:     none\n'
	fi
	exit $status
	;;
ctl)
	ctl "$@"
	;;
tern)
	iso tern "$@"
	;;
type)
	[ $# -eq 1 ] || die "usage: tern-verify type RUN 'command line'"
	case $1 in *'"'*) die "the command line cannot hold a double quote" ;; esac
	ctl run "\"$1\""
	;;
shot)
	[ $# -eq 1 ] || die "usage: tern-verify shot RUN NAME"
	name=$1
	reply=$(ctl shot "$name")
	png=$data/$(printf %s "$reply" | jq -r .png)
	layout=$data/$(printf %s "$reply" | jq -r .layout)
	bun -e 'const [png, out] = process.argv.slice(1);
await Bun.write(out, await new Bun.Image(await Bun.file(png).bytes()).webp({ lossless: true }).bytes());' \
		"$png" "$run/$name.webp"
	mv "$layout" "$run/$name.layout.json"
	rm -f "$png"
	printf '%s\n%s\n' "$run/$name.webp" "$run/$name.layout.json"
	;;
lens)
	lens=$run/link-lens
	mkdir -p "$lens"
	cat >"$lens/plugin.toml" <<'EOF'
schema = 1
id = "verify-link-lens"
name = "Verify link lens"
version = "0.1.0"
host = "host.luau"

[[lenses]]
id = "link"
match = ["echo PROBE_LINK *"]
EOF
	cat >"$lens/host.luau" <<'EOF'
tern.lens.define("link", {
	-- Captures the URL from the terminal command's last argument.
	open = function(run, cx)
		return { url = run.args[#run.args] }
	end,
	-- Ignores terminal output; the lens renders only the captured URL.
	line = function(state, line) end,
	-- Keeps no completion state.
	finish = function(state, status) end,
	-- Renders the URL as a clickable Tern link.
	view = function(state)
		return tern.ui.text({ tern.ui.link("PROBE_LINK " .. state.url, state.url) })
	end,
})
EOF
	[ -f "$cfg/plugins/verify-link-lens.path" ] || iso tern plugin link "$lens" >>"$run/start.log" 2>&1 ||
		die "plugin link failed for $lens, see $run/start.log"
	iso tern plugin reload
	;;
stop)
	window_pid=$(cat "$data/window.pid" 2>/dev/null || true)
	daemon_pid=$(socket_owner "$daemon_sock")
	[ -n "$daemon_pid" ] || daemon_pid=$(cat "$data/daemon.pid" 2>/dev/null || true)
	if [ -S "$ctl_sock" ]; then ctl quit >/dev/null 2>&1 || true; fi
	# `ctl quit` closes the window. The daemon keeps running, and its panes end when it stops.
	# The window gets 2 s to close by itself, the daemon gets SIGTERM at once.
	for pid in $window_pid $daemon_pid; do
		[ "$pid" = "$daemon_pid" ] && kill "$pid" 2>/dev/null || true
		tries=0
		while kill -0 "$pid" 2>/dev/null && [ $tries -lt 20 ]; do
			if [ $tries -eq 8 ]; then kill "$pid" 2>/dev/null || true; fi
			tries=$((tries + 1))
			sleep 0.25
		done
		if kill -0 "$pid" 2>/dev/null; then
			printf 'pid %s still runs after SIGTERM, sending SIGKILL\n' "$pid"
			kill -9 "$pid" 2>/dev/null || true
		fi
	done
	# A pane program can outlive the daemon: Neovim's `nvim --embed` server stays as an orphan and
	# ignores SIGTERM. Its command line names a file in RUN/data, a dir that only this run has.
	leftovers() { ps -Ao pid=,command= | grep -F "$data/" | grep -v grep | awk '{print $1}' || true; }
	pids=$(leftovers)
	if [ -n "$pids" ]; then
		printf 'ending leftover processes of this run: %s\n' "$(echo $pids)"
		kill $pids 2>/dev/null || true
		sleep 1
		pids=$(leftovers)
		[ -z "$pids" ] || kill -9 $pids 2>/dev/null || true
	fi
	rm -rf "$(omp_session_dir)" "$data"
	printf 'stopped window %s and daemon %s; kept:\n' "${window_pid:-none}" "${daemon_pid:-none}"
	ls -1 "$run"
	;;
*)
	die "unknown command: $cmd"
	;;
esac
