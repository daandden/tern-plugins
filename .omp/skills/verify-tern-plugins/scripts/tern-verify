#!/bin/sh
# Starts and drives a Tern instance in a run-owned config and sockets.
#
#   tern-verify start  RUN [--profile tern-plugins|omp-tools] [--headless | --dir DIR]
#   tern-verify doctor RUN            read-only check of the instance
#   tern-verify ctl    RUN ARGS...    `tern ctl` on the instance's control socket
#   tern-verify tern   RUN ARGS...    any `tern` CLI command against the instance
#   tern-verify type   RUN LINE       types LINE and Enter into the focused pane
#   tern-verify shot   RUN NAME       RUN/NAME.webp (lossless) and RUN/NAME.layout.json
#   tern-verify lens   RUN            links RUN/link-lens: `echo PROBE_LINK URL` shows URL as a link
#   tern-verify stop   RUN            stop the instance and remove its state
#
# TERN_PLUGINS_REPO overrides the checkout whose plugins load (default: the checkout of this file).

set -eu

die() {
	printf 'tern-verify: %s\n' "$*" >&2
	exit 1
}

[ $# -ge 2 ] || die "usage: tern-verify start|doctor|ctl|tern|type|shot|lens|stop RUN [ARGS...]"
cmd=$1
case $2 in
/*) run=$2 ;;
*) run=$(pwd)/$2 ;;
esac
shift 2

data=$run/data
state=$run/instance
cfg=$state/config
script_dir=$(cd "$(dirname "$0")" && pwd -P)
repo=${TERN_PLUGINS_REPO:-$(git -C "$script_dir" rev-parse --show-toplevel)}

if [ "$cmd" != start ]; then
	[ -d "$state" ] || die "no instance in $run"
	profile=$(cat "$state/profile")
	mode=$(cat "$state/mode")
	sockets=$(cat "$state/sockets" 2>/dev/null || true)
fi

set_sockets() {
	case ${sockets:-} in
	/tmp/tern-verify.*)
		[ "${sockets%/*}" = /tmp ] && [ -d "$sockets" ] && [ ! -L "$sockets" ] ||
			die "invalid socket directory: $sockets"
		;;
	*) die "missing run-owned sockets for $run" ;;
	esac
	ctl_sock=$sockets/ctl.sock
	daemon_sock=$sockets/daemon.sock
}

# A tern command against this instance only. With the TERN_PANE* and TERN_WINDOW* variables of the
# calling pane, a CLI command goes to the window of that pane.
iso() {
	env -u TERN_PANE -u TERN_PANE_SOCKET -u TERN_WINDOW_KEY -u TERN_WINDOW_SOCKET \
		-u TERN_IDENTITY -u TERN_EXE -u TERN_BLOB_DIR -u TERN_LENSES -u TERN_COMPLETE \
		TERN_CONFIG_DIR="$cfg" TERN_DAEMON_SOCKET="$daemon_sock" "$@"
}

ctl() {
	iso tern ctl --control "$ctl_sock" "$@"
}

responds() {
	[ -S "$ctl_sock" ] && ctl state 2>/dev/null | jq -e '.ok' >/dev/null
}

plugin_sheets() {
	ctl css | jq -er '[.sheets[].name | select(startswith("plugin:"))] | join(" ")'
}

descendants() (
	for child in $(pgrep -P "$1" || true); do
		printf '%s\n' "$child"
		descendants "$child"
	done
)

process_stamp() {
	ps -o lstart= -p "$1" 2>/dev/null
}

snapshot_process() {
	stamp=$(process_stamp "$1") || return 0
	printf '%s\n' "$stamp" >"$state/processes/$1"
}

owned_alive() {
	[ -s "$state/processes/$1" ] &&
		[ "$(process_stamp "$1")" = "$(cat "$state/processes/$1")" ]
}

wait_for_exit() {
	tries=0
	while :; do
		left=
		for pid do
			if owned_alive "$pid"; then left="$left $pid"; fi
		done
		[ -n "$left" ] || return 0
		[ "$tries" -lt 8 ] || return 1
		tries=$((tries + 1))
		sleep 0.25
	done
}

signal_owned() {
	signal=$1
	shift
	for pid do
		if owned_alive "$pid"; then kill "-$signal" "$pid" 2>/dev/null || true; fi
	done
}

# The pid that holds a socket file open, or nothing.
socket_owner() {
	[ -S "$1" ] && lsof -t "$1" 2>/dev/null | head -n 1 || true
}

# The omp session dir of a pane that ran omp in RUN/data, as omp names it.
omp_session_dir() {
	rel=${data#"$HOME"/}
	printf '%s/.omp/agent/sessions/-%s\n' "$HOME" "$(printf %s "$rel" | tr / -)"
}

case $cmd in
start)
	profile=tern-plugins
	mode=window
	dir=
	while [ $# -gt 0 ]; do
		case $1 in
		--profile) [ $# -ge 2 ] || die "--profile needs a name"; profile=$2; shift ;;
		--headless) mode=serve ;;
		--dir) [ $# -ge 2 ] || die "--dir needs a path"; dir=$2; shift ;;
		*) die "unknown start option: $1" ;;
		esac
		shift
	done
	case $profile in tern-plugins|omp-tools) ;; *) die "unknown profile: $profile" ;; esac
	[ "$mode" = window ] || { [ "$profile" = omp-tools ] && [ -z "$dir" ]; } ||
		die "--headless requires --profile omp-tools and accepts no --dir"
	[ -d "$run" ] || die "$run does not exist: make it with mktemp -d"
	if [ "$profile" = tern-plugins ]; then
		[ ! -e "$data" ] || die "$data exists: choose a new run; do not stop this one"
	fi
	mkdir "$state" 2>/dev/null || die "$state exists: another run owns $run, so do not stop it"
	printf '%s\n' "$profile" >"$state/profile"
	printf '%s\n' "$mode" >"$state/mode"
	mkdir "$cfg" "$state/processes"
	sockets=$(mktemp -d /tmp/tern-verify.XXXXXX)
	printf '%s\n' "$sockets" >"$state/sockets"
	set_sockets

	if [ "$profile" = tern-plugins ]; then
		mkdir "$data"
		: >"$state/disposable-data"
		if [ -f "$HOME/.config/tern/settings.json" ]; then
			jq '.shell = "/bin/zsh"' "$HOME/.config/tern/settings.json" >"$cfg/settings.json"
		else
			printf '{"shell":"/bin/zsh"}\n' >"$cfg/settings.json"
		fi
		dir=${dir:-$data}
	else
		printf '{"shell":"/bin/zsh"}\n' >"$cfg/settings.json"
		dir=${dir:-$run}
	fi
	[ -d "$dir" ] || die "tab folder does not exist: $dir"
	dir=$(cd "$dir" && pwd -P)
	# A config dir with no omp state makes Tern show its native "Tern is better with omp. Install it?"
	# alert on top of the screen. This is the state that Tern writes when you answer Not Now.
	mkdir "$cfg/omp"
	printf '{"managed":false,"checked":0,"no_build":false,"offered":true}\n' >"$cfg/omp/state.json"
	# Tern 0.9.26 opens its "macOS permissions" dialog in a config dir without this marker, and the
	# dialog takes the keys that a run sends. Tern writes the empty file once it showed the dialog.
	: >"$cfg/permissions-offered"
	tern_exe=$(command -v tern) || die "tern is not on PATH"
	launch_path=$PATH
	out=$run
	if [ "$profile" = tern-plugins ]; then
		for manifest in "$repo"/tern/*/plugin.toml; do
			iso "$tern_exe" plugin link "$(dirname "$manifest")" >>"$run/start.log" 2>&1 ||
				die "plugin link failed for $(dirname "$manifest"), see $run/start.log"
		done
		# Match a Tern window opened from the Dock.
		launch_path=/usr/bin:/bin:/usr/sbin:/sbin
		out=$data
	fi
	cd "$out"
	if [ "$mode" = serve ]; then
		set -- serve --control "$ctl_sock" --out "$run"
	else
		/usr/bin/caffeinate -u -t 2
		set -- --control "$ctl_sock" --dir "$dir"
	fi
	iso env PATH="$launch_path" SHELL=/bin/zsh "$tern_exe" "$@" \
		>"$run/$mode.log" 2>&1 </dev/null &
	launch_pid=$!
	printf '%s\n' "$launch_pid" >"$state/launch.pid"
	tries=0
	until responds; do
		tries=$((tries + 1))
		[ "$tries" -le 60 ] || die "no control reply after 30 s, see $run/$mode.log"
		sleep 0.5
	done
	instance_pid=$(socket_owner "$ctl_sock")
	[ -n "$instance_pid" ] || die "no owner for $ctl_sock"
	printf '%s\n' "$instance_pid" >"$run/instance.pid"
	daemon_pid=
	if [ "$mode" = window ]; then
		/usr/bin/caffeinate -d -w "$instance_pid" >/dev/null 2>&1 &
		ctl ready >/dev/null || die "no shell prompt, see $run/window.log"
		tries=0
		while daemon_pid=$(socket_owner "$daemon_sock") && [ -z "$daemon_pid" ]; do
			tries=$((tries + 1))
			[ "$tries" -le 20 ] || die "no session daemon on $daemon_sock, see $run/window.log"
			sleep 0.5
		done
	fi
	printf '%s\n' "$daemon_pid" >"$run/daemon.pid"
	if [ "$profile" = tern-plugins ]; then
		tries=0
		until ctl css 2>/dev/null | grep -q '"plugin:local:'; do
			tries=$((tries + 1))
			[ "$tries" -le 60 ] || die "no plugin sheets after 30 s, see $run/window.log"
			sleep 0.5
		done
	fi
	printf 'ready: %s pid %s, daemon pid %s, repo %s\n' \
		"$mode" "$instance_pid" "${daemon_pid:-none}" "$repo"
	;;
doctor)
	set_sockets
	status=0
	instance_pid=$(cat "$run/instance.pid" 2>/dev/null || true)
	printf 'run:        %s (%s, %s)\n' "$run" "$profile" "$mode"
	printf 'repo:       %s (%s)\n' "$repo" "$(git -C "$repo" rev-parse --short HEAD)"
	printf 'tern:       %s\n' "$(tern --version)"
	control_pid=$(socket_owner "$ctl_sock")
	printf 'control:    owner %s (started as %s)\n' "${control_pid:-none}" "${instance_pid:-none}"
	[ -n "$control_pid" ] && [ "$control_pid" = "$instance_pid" ] || status=1
	if [ "$mode" = window ]; then
		daemon_pid=$(socket_owner "$daemon_sock")
		if [ -n "$daemon_pid" ]; then
			printf 'daemon:     pid %s (started as %s)\n' "$daemon_pid" "$(cat "$run/daemon.pid")"
		else
			printf 'daemon:     NOT RUNNING\n'
			status=1
		fi
	fi
	if ! ctl state >"$state/doctor-state.json" 2>&1; then
		printf 'ctl state:  FAILED: %s\n' "$(cat "$state/doctor-state.json")"
		status=1
	else
		printf 'sessions:   %s\n' "$(jq -c '[.sessions[] | {name, tabs}]' "$state/doctor-state.json")"
		printf 'focused:    %s\n' "$(jq -c '.focused | {id, label}' "$state/doctor-state.json")"
	fi
	if [ "$mode" = window ]; then
		daemon_sessions=$(iso tern ls 2>&1) || status=1
		if [ "$daemon_sessions" = "no sessions" ]; then
			printf 'daemon sessions: NONE\n'
			status=1
		fi
	fi
	printf 'plugins:\n'
	plugins=$(iso tern plugin list) || status=1
	printf '%s\n' "$plugins" | sed 's/^/  /'
	if [ -n "$plugins" ] && [ "$plugins" != 'no plugins' ] &&
		printf '%s\n' "$plugins" | grep -qv ' ready$'; then status=1; fi
	for link in "$cfg"/plugins/*.path; do
		[ -f "$link" ] || continue
		target=$(cat "$link")
		case $target in
		"$repo"/*) ;;
		"$run"/link-lens) printf 'run lens:   %s\n' "$target" ;;
		*)
			printf 'LINK OUTSIDE REPO: %s -> %s\n' "$link" "$target"
			status=1
			;;
		esac
	done
	sheets=$(plugin_sheets) || status=1
	printf 'sheets:     %s\n' "$sheets"
	if [ "$profile" = tern-plugins ]; then
		[ -n "$sheets" ] || status=1
		account=$(ctl a11y | jq -r '[.. | objects | select(.role == "Button") | .name // empty
			| select(startswith("Signed in to Stencil"))][0] // "NOT SIGNED IN"')
		printf 'account:    %s\n' "$account"
		[ "$account" != "NOT SIGNED IN" ] || status=1
	fi
	# Shots do not show a native alert, so list it here.
	alerts=$(ctl system | jq -er '.dialogs | map("\(.message) \(.buttons)") | join("\n")') || status=1
	if [ -n "$alerts" ]; then
		printf 'NATIVE ALERT OPEN: %s\n' "$alerts"
		status=1
	else
		printf 'alerts:     none\n'
	fi
	exit $status
	;;
ctl)
	set_sockets
	ctl "$@"
	;;
tern)
	set_sockets
	iso tern "$@"
	;;
type)
	set_sockets
	[ $# -eq 1 ] || die "usage: tern-verify type RUN 'command line'"
	case $1 in *'"'*) die "the command line cannot hold a double quote" ;; esac
	ctl run "\"$1\""
	;;
shot)
	set_sockets
	[ $# -eq 1 ] || die "usage: tern-verify shot RUN NAME"
	name=$1
	reply=$(ctl shot "$name")
	base=$run
	[ "$profile" != tern-plugins ] || base=$data
	png=$(printf %s "$reply" | jq -er .png)
	layout=$(printf %s "$reply" | jq -er .layout)
	case $png in /*) ;; *) png=$base/$png ;; esac
	case $layout in /*) ;; *) layout=$base/$layout ;; esac
	bun -e 'const [png, out] = process.argv.slice(1);
await Bun.write(out, await new Bun.Image(await Bun.file(png).bytes()).webp({ lossless: true }).bytes());' \
		"$png" "$run/$name.webp"
	mv "$layout" "$run/$name.layout.json"
	rm -f "$png"
	printf '%s\n%s\n' "$run/$name.webp" "$run/$name.layout.json"
	;;
lens)
	set_sockets
	lens=$run/link-lens
	mkdir -p "$lens"
	cat >"$lens/plugin.toml" <<'EOF'
schema = 1
id = "verify-link-lens"
name = "Verify link lens"
version = "0.1.0"
host = "host.luau"

[[lenses]]
id = "link"
match = ["echo PROBE_LINK *"]
EOF
	cat >"$lens/host.luau" <<'EOF'
tern.lens.define("link", {
	-- Captures the URL from the terminal command's last argument.
	open = function(run, cx)
		return { url = run.args[#run.args] }
	end,
	-- Ignores terminal output; the lens renders only the captured URL.
	line = function(state, line) end,
	-- Keeps no completion state.
	finish = function(state, status) end,
	-- Renders the URL as a clickable Tern link.
	view = function(state)
		return tern.ui.text({ tern.ui.link("PROBE_LINK " .. state.url, state.url) })
	end,
})
EOF
	[ -f "$cfg/plugins/verify-link-lens.path" ] || iso tern plugin link "$lens" >>"$run/start.log" 2>&1 ||
		die "plugin link failed for $lens, see $run/start.log"
	iso tern plugin reload
	;;
stop)
	instance_pid=
	daemon_pid=
	if [ -n "$sockets" ]; then
		set_sockets
		instance_pid=$(socket_owner "$ctl_sock")
		daemon_pid=$(socket_owner "$daemon_sock")
		if [ -z "$instance_pid" ] && [ -s "$state/launch.pid" ]; then
			launch_pid=$(cat "$state/launch.pid")
			case $(ps -ww -o command= -p "$launch_pid" 2>/dev/null) in
			*"$ctl_sock"*) instance_pid=$launch_pid ;;
			esac
		fi
	fi
	pids=
	for root_pid in $instance_pid $daemon_pid; do
		pids="$pids $(descendants "$root_pid") $root_pid"
	done
	for pid in $pids; do snapshot_process "$pid"; done
	if [ -n "$instance_pid" ] && [ -S "$ctl_sock" ]; then
		ctl quit >/dev/null 2>&1 || true
		wait_for_exit "$instance_pid" || true
	fi
	signal_owned TERM $pids
	if ! wait_for_exit $pids; then
		signal_owned KILL $left
		wait_for_exit $left || die "owned processes did not exit:$left"
	fi
	if [ -n "$sockets" ]; then rm -rf "$sockets"; fi
	if [ -f "$state/disposable-data" ]; then rm -rf "$(omp_session_dir)" "$data"; fi
	rm -rf "$state"
	printf 'stopped instance %s and daemon %s; kept:\n' "${instance_pid:-none}" "${daemon_pid:-none}"
	ls -1 "$run"
	;;
*)
	die "unknown command: $cmd"
	;;
esac
