#!/bin/sh
# In a Tern pane, `open FILE...` shows local files in Tern beside the pane that ran it, in that
# pane's tab: `tern open` puts a file block beside the pane that runs it. macOS open sends a file to
# the tab that has the focus, because its request to Tern names no pane. Every other call (no Tern
# pane, an option, a URL, a directory, an app) goes to /usr/bin/open.

TERN=$(command -v tern)
if [ -z "$TERN_PANE" ] || [ -z "$TERN" ] || [ $# -eq 0 ]; then
	exec /usr/bin/open "$@"
fi
for arg in "$@"; do
	case $arg in
	-*) exec /usr/bin/open "$@" ;;
	esac
	[ -f "$arg" ] || exec /usr/bin/open "$@"
done

status=0
for arg in "$@"; do
	"$TERN" open "$arg" || status=$?
done
exit "$status"
